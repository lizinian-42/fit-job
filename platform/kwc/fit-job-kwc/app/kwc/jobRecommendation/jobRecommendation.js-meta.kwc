<?xml version="1.0" encoding="UTF-8"?>
<KingdeeComponentBundle
    xmlns="http://dev.kingdee.com/2025/10/metadata"
>
    <version>1</version>
    <name>jobRecommendation</name>
    <masterLabel>岗位推荐与六维匹配</masterLabel>
    <description>推荐岗位列表、六维匹配评分、匹配分析、短板说明、面试准备建议与一键申请</description>
    <isv></isv>
    <app>fitjob</app>
    <framework>lwc</framework>
    <targets>
        <target>KWCFormModel</target>
    </targets>
    <targetConfigs>
        <targetConfig>
          <targets>KWCFormModel</targets>
        </targetConfig>
    </targetConfigs>
</KingdeeComponentBundle>
