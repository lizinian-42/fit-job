<?xml version="1.0" encoding="UTF-8"?>
<KingdeeComponentBundle
    xmlns="http://dev.kingdee.com/2025/10/metadata"
>
    <version>1</version>
    <name>studentWorkbench</name>
    <masterLabel>学生工作台</masterLabel>
    <description>学生画像、快捷入口、求职进度、推荐岗位与待办事项总览</description>
